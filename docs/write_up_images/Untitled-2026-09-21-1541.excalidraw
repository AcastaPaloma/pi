    {
      "id": "vcInBdrSB5E1QAIA2jQko",
      "type": "text",
      "x": -8780.891639633228,
      "y": 2924.2402626070834,
      "width": 1862.9767489030435,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c15O",
      "roundness": null,
      "seed": 1570118552,
      "version": 783,
      "versionNonce": 350642826,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791226025482,
      "created": 1791159791086,
      "link": null,
      "locked": false,
      "text": "This will be particularly counterintuitive. The decoder of the low-level VLA is completely scrapped during\ninference. It is solely used to condition the encoder to encode spatial/semantic context optimizing for\nthe prediction of future continuous actions. Similar to Google Genie's encoder conditioned to optimize\nfor the prediction of future frames. \n\nDuring inference, the trained low-level VlA's encoder is used to output the input for the flow-matching\naction expert model downstream. ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This will be particularly counterintuitive. The decoder of the low-level VLA is completely scrapped during inference. It is solely used to condition the encoder to encode spatial/semantic context optimizing for the prediction of future continuous actions. Similar to Google Genie's encoder conditioned to optimize for the prediction of future frames. \n\nDuring inference, the trained low-level VlA's encoder is used to output the input for the flow-matching action expert model downstream. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
